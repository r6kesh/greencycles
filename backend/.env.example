PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/scrapDB
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=30d
CUSTOMER_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

# Twilio (Optional, fallback provided)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay (Required for Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
